# Copie este arquivo para .env e preencha com as suas chaves.
# O arquivo .env NUNCA vai para o GitHub (está no .gitignore).

# Para analisar imagens, GEMINI_API_KEY é necessária.
# Consultas sem imagem priorizam PROVEDOR e podem recorrer ao outro provedor.
GROQ_API_KEY=
GEMINI_API_KEY=

# Provedor preferido para consultas sem imagem: groq ou gemini
PROVEDOR=groq
GEMINI_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-20b